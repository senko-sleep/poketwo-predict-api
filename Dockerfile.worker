FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OpenCV
RUN apt-get update && apt-get install -y \
    libgomp1 \
    libxcb1 \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy models
COPY models/ ./models/

# Copy prediction worker script
COPY prediction_worker.py .

# Verify files exist
RUN ls -lh models/pokemon_cnn_v2.onnx models/labels_v2.json

# Expose port (each worker uses different port)
EXPOSE 8080

# Run prediction worker
CMD ["python", "prediction_worker.py"]
